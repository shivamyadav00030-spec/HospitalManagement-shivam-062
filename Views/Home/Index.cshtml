@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}
<div class="page-heading"><div><div class="eyebrow">Overview · @Model.CurrentLocalTime.ToString("dddd, dd MMMM yyyy")</div><h1>Good day</h1><p>Administrative activity at a glance. Figures reflect records stored in the connected database.</p></div><a class="btn btn-primary" asp-controller="Appointments" asp-action="Create">＋ Book appointment</a></div>
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3"><a asp-controller="Patients" asp-action="Index" class="text-reset"><div class="stat-card"><div class="stat-label">Registered patients</div><div class="stat-value">@Model.PatientCount</div><div class="stat-foot">Patient directory</div></div></a></div>
    <div class="col-6 col-xl-3"><a asp-controller="Doctors" asp-action="Index" class="text-reset"><div class="stat-card"><div class="stat-label">Doctors</div><div class="stat-value">@Model.DoctorCount</div><div class="stat-foot">Clinical directory</div></div></a></div>
    <div class="col-6 col-xl-3"><a asp-controller="Departments" asp-action="Index" class="text-reset"><div class="stat-card"><div class="stat-label">Departments</div><div class="stat-value">@Model.DepartmentCount</div><div class="stat-foot">Service groups</div></div></a></div>
    <div class="col-6 col-xl-3"><a asp-controller="Appointments" asp-action="Index" class="text-reset"><div class="stat-card"><div class="stat-label">All appointments</div><div class="stat-value">@Model.AppointmentCount</div><div class="stat-foot">@Model.TodayAppointmentCount today</div></div></a></div>
    <div class="col-6 col-xl-3"><a asp-controller="Appointments" asp-action="Index" class="text-reset"><div class="stat-card"><div class="stat-label">Today’s appointments</div><div class="stat-value">@Model.TodayAppointmentCount</div><div class="stat-foot">Configured local time</div></div></a></div>
    <div class="col-6 col-xl-3"><a asp-controller="Appointments" asp-action="Index" asp-route-status="Scheduled" class="text-reset"><div class="stat-card"><div class="stat-label">Pending appointments</div><div class="stat-value">@Model.PendingAppointmentCount</div><div class="stat-foot">Scheduled or confirmed</div></div></a></div>
    <div class="col-6 col-xl-3"><a asp-controller="Bills" asp-action="Index" class="text-reset"><div class="stat-card"><div class="stat-label">Recorded bills</div><div class="stat-value">@Model.BillCount</div><div class="stat-foot">Educational billing records</div></div></a></div>
</div>
<section class="panel"><div class="panel-heading"><div><h2>Recent appointments</h2><span class="text-muted-small">Latest records across all statuses</span></div><a class="btn btn-sm btn-outline-primary" asp-controller="Appointments" asp-action="Index">View appointments</a></div>
    @if (Model.RecentAppointments.Count == 0) { <div class="empty-state"><div class="empty-mark">◷</div><h3>No appointment records yet</h3><p>When appointments are booked, they will appear here along with the live dashboard counts.</p></div> }
    else { <div class="table-responsive"><table class="table align-middle"><thead><tr><th>Appointment</th><th>Patient</th><th>Doctor / department</th><th>Date and time</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var appt in Model.RecentAppointments) { <tr><td><span class="code-pill">@appt.AppointmentCode</span></td><td><span class="record-primary">@appt.PatientName</span><span class="record-secondary">@appt.PatientCode</span></td><td><span class="record-primary">@appt.DoctorName</span><span class="record-secondary">@appt.DepartmentName</span></td><td>@appt.AppointmentDateTimeLocal.ToString("dd MMM, h:mm tt")</td><td><span class="badge-status status-@appt.Status.ToString().ToLowerInvariant()">@appt.Status</span></td><td class="text-end"><a class="btn btn-sm btn-light" asp-controller="Appointments" asp-action="Details" asp-route-id="@appt.AppointmentId">View</a></td></tr> }</tbody></table></div> }
</section>
