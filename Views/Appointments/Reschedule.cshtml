@model RescheduleViewModel
@{ ViewData["Title"] = "Reschedule appointment"; }
<div class="page-heading"><div><div class="eyebrow">Appointment · @Model.AppointmentCode</div><h1>Reschedule</h1><p>Select a new future slot for this appointment.</p></div><a class="btn btn-light" asp-action="Details" asp-route-id="@Model.AppointmentId">Cancel</a></div>
<section class="panel"><form asp-action="Reschedule" asp-route-id="@Model.AppointmentId" method="post"><input asp-for="AppointmentId" type="hidden" /><input asp-for="AppointmentCode" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3"></div><div class="col-md-6"><label asp-for="AppointmentDateTimeLocal" class="form-label">New date and time (@Model.TimeZoneName)</label><input asp-for="AppointmentDateTimeLocal" type="datetime-local" class="form-control" step="1800" /><span asp-validation-for="AppointmentDateTimeLocal" class="field-validation-error"></span><div class="form-text">30-minute slots start on the hour or half-hour.</div></div><div class="action-row mt-4"><button class="btn btn-primary" type="submit">Save new time</button><a class="btn btn-light" asp-action="Details" asp-route-id="@Model.AppointmentId">Cancel</a></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
