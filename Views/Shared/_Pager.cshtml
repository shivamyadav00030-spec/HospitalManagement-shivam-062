@model PagerViewModel
@if (Model.TotalPages > 1)
{
    var previous = new Dictionary<string, string?>(Model.RouteValues) { ["page"] = (Model.Page - 1).ToString() };
    var next = new Dictionary<string, string?>(Model.RouteValues) { ["page"] = (Model.Page + 1).ToString() };
    <nav aria-label="Pagination" class="mt-3">
        <ul class="pagination pagination-sm mb-0 justify-content-end">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                <a class="page-link" aria-label="Previous page" href="@(Model.Page <= 1 ? "#" : Url.Action("Index", Model.ControllerName, previous))">Previous</a>
            </li>
            <li class="page-item active" aria-current="page"><span class="page-link">@Model.Page of @Model.TotalPages</span></li>
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" aria-label="Next page" href="@(Model.Page >= Model.TotalPages ? "#" : Url.Action("Index", Model.ControllerName, next))">Next</a>
            </li>
        </ul>
    </nav>
}
