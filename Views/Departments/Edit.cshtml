@model DepartmentFormViewModel
@{ ViewData["Title"] = "Edit department"; }
<div class="page-heading"><div><div class="eyebrow">Hospital directory</div><h1>Edit department</h1><p>Update department information.</p></div><a class="btn btn-light" asp-action="Details" asp-route-id="@Model.DepartmentId">Cancel</a></div>
<section class="panel"><form asp-action="Edit" asp-route-id="@Model.DepartmentId" method="post"><partial name="_FormFields" model="Model" /><div class="action-row mt-4"><button class="btn btn-primary" type="submit">Save changes</button><a class="btn btn-light" asp-action="Details" asp-route-id="@Model.DepartmentId">Cancel</a></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
