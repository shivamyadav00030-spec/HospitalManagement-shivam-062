@model DepartmentFormViewModel
<input asp-for="DepartmentId" type="hidden" />
<div asp-validation-summary="ModelOnly" class="validation-summary-errors mb-3"></div>
<div class="row g-3"><div class="col-md-7"><label asp-for="DepartmentName" class="form-label">Department name</label><input asp-for="DepartmentName" class="form-control" /><span asp-validation-for="DepartmentName" class="field-validation-error"></span></div><div class="col-12"><label asp-for="Description" class="form-label">Description <span class="text-muted-small">(optional)</span></label><textarea asp-for="Description" class="form-control" rows="3"></textarea><span asp-validation-for="Description" class="field-validation-error"></span></div></div>
