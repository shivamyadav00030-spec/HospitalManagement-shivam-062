@model DoctorFormViewModel
@{ ViewData["Title"] = "Edit doctor"; }
<div class="page-heading"><div><div class="eyebrow">Clinical directory</div><h1>Edit doctor</h1><p>Update this doctor’s administrative profile.</p></div><a class="btn btn-light" asp-action="Details" asp-route-id="@Model.DoctorId">Cancel</a></div>
<section class="panel"><form asp-action="Edit" asp-route-id="@Model.DoctorId" method="post"><partial name="_FormFields" model="Model" /><div class="action-row mt-4"><button class="btn btn-primary" type="submit">Save changes</button><a class="btn btn-light" asp-action="Details" asp-route-id="@Model.DoctorId">Cancel</a></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
