@model DoctorDetailsViewModel
@{
    ViewData["Title"] = "Doctor profile";
    var doctor = Model.Doctor;
}
<div class="page-heading"><div><div class="eyebrow">Doctor profile · <span class="code-pill">@doctor.DoctorCode</span></div><h1>@doctor.FullName</h1><p>@doctor.Specialization · @doctor.Department?.DepartmentName</p></div><div class="action-row"><a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@doctor.DoctorId">Edit profile</a><a class="btn btn-primary" asp-controller="Appointments" asp-action="Create" asp-route-doctorId="@doctor.DoctorId">Book appointment</a></div></div>
<div class="row g-3"><div class="col-lg-7"><section class="panel"><div class="panel-heading"><h2>Professional information</h2><span class="badge-status @(doctor.IsAvailable ? "status-active" : "status-inactive")">@(doctor.IsAvailable ? "Available" : "Inactive")</span></div><dl class="detail-grid"><div class="detail-item"><dt>Department</dt><dd>@doctor.Department?.DepartmentName</dd></div><div class="detail-item"><dt>Specialization</dt><dd>@doctor.Specialization</dd></div><div class="detail-item"><dt>Consultation fee</dt><dd>INR INR @doctor.ConsultationFee.ToString("N2")</dd></div><div class="detail-item"><dt>Phone</dt><dd>@doctor.PhoneNumber</dd></div><div class="detail-item"><dt>Email</dt><dd>@(doctor.Email ?? "Not provided")</dd></div><div class="detail-item"><dt>Upcoming appointments</dt><dd>@Model.UpcomingAppointmentCount</dd></div></dl>
@if (doctor.IsAvailable) { <form asp-action="SetAvailability" asp-route-id="@doctor.DoctorId" method="post" data-confirm="Deactivate this doctor? Existing appointment history will be kept."><input type="hidden" name="isAvailable" value="false" /><button class="btn btn-sm btn-outline-danger mt-4" type="submit">Deactivate doctor</button></form> } else { <form asp-action="SetAvailability" asp-route-id="@doctor.DoctorId" method="post"><input type="hidden" name="isAvailable" value="true" /><button class="btn btn-sm btn-outline-primary mt-4" type="submit">Reactivate doctor</button></form> }
</section></div><div class="col-lg-5"><section class="panel"><h2 class="h6 fw-bold">Booking notes</h2><p class="text-muted-small mb-0">New bookings require an active patient and an available doctor. Existing appointments and bills remain linked if the doctor is deactivated.</p></section></div></div>
