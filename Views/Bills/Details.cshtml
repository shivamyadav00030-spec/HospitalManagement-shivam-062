@model BillDetailsViewModel
@{ ViewData["Title"] = "Bill details"; }
<div class="page-heading no-print"><div><div class="eyebrow">Billing record</div><h1>@Model.Bill.BillNumber</h1><p>Basic educational invoice. No payment information is stored.</p></div><div class="action-row"><a class="btn btn-outline-primary" asp-action="Invoice" asp-route-id="@Model.Bill.BillId">Print-friendly view</a><a class="btn btn-light" asp-action="Index">Back to bills</a></div></div>
<div class="invoice-paper">
    <div class="invoice-header"><div><div class="brand-mark mb-3">H</div><h1>Hospital Management System</h1><p class="text-muted-small mb-0">Administrative billing demonstration</p></div><div class="invoice-number"><strong>INVOICE</strong><div class="mt-2">@Model.Bill.BillNumber</div><span class="record-secondary">@Model.BillDateLocal.ToString("dd MMM yyyy")</span></div></div>
    <div class="row g-3 py-4"><div class="col-sm-6"><div class="text-muted-small">Bill to</div><div class="record-primary mt-1">@Model.Bill.Patient?.FullName</div><div class="record-secondary">Patient code: @Model.Bill.Patient?.PatientCode</div></div><div class="col-sm-6"><div class="text-muted-small">Appointment</div><div class="record-primary mt-1">@(Model.Bill.Appointment?.AppointmentCode ?? "Administrative service")</div><div class="record-secondary">@(Model.AppointmentDateTimeLocal?.ToString("dd MMM yyyy, h:mm tt") ?? "No appointment linked")</div></div></div>
    <div class="table-responsive"><table class="table"><thead><tr><th>Description</th><th class="text-end">Amount (INR)</th></tr></thead><tbody><tr><td>@Model.Bill.Description <span class="record-secondary">@(Model.Bill.Appointment?.Doctor?.FullName ?? "Administrative service")</span></td><td class="text-end">@Model.Bill.Subtotal.ToString("N2")</td></tr><tr><td>Discount</td><td class="text-end">− @Model.Bill.DiscountAmount.ToString("N2")</td></tr><tr><td>Tax (@Model.TaxRateLabel)</td><td class="text-end">@Model.Bill.TaxAmount.ToString("N2")</td></tr></tbody><tfoot><tr><th class="text-end">Total</th><th class="text-end invoice-total">INR @Model.Bill.TotalAmount.ToString("N2")</th></tr></tfoot></table></div>
    <div class="d-flex justify-content-between align-items-center py-3 border-top"><span>Payment status</span><span class="badge-status status-@Model.Bill.PaymentStatus.ToString().ToLowerInvariant()">@Model.Bill.PaymentStatus</span></div>
    <div class="soft-callout mt-3">This invoice is for an academic demonstration only. It is not a tax document, receipt, or record of payment processing.</div>
    <div class="action-row mt-4 no-print"><button class="btn btn-outline-primary" type="button" onclick="window.print()">Print invoice</button>@if (Model.Bill.PaymentStatus == PaymentStatus.Unpaid) { <form asp-action="MarkPaid" asp-route-id="@Model.Bill.BillId" method="post" data-confirm="Mark this demo bill as paid? This does not process a payment."><button class="btn btn-primary" type="submit">Mark as paid (demo)</button></form> }</div>
</div>
