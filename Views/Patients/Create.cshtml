@model PatientFormViewModel
@{ ViewData["Title"] = "Register patient"; }
<div class="page-heading"><div><div class="eyebrow">Patient records</div><h1>Register patient</h1><p>Enter fictional demo information. The patient code is generated automatically.</p></div><a class="btn btn-light" asp-action="Index">Back to patients</a></div>
<section class="panel"><form asp-action="Create" method="post"><partial name="_FormFields" model="Model" /><div class="action-row mt-4"><button class="btn btn-primary" type="submit">Save patient</button><a class="btn btn-light" asp-action="Index">Cancel</a></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
