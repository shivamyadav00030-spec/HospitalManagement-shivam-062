@model PatientDetailsViewModel
@{
    ViewData["Title"] = "Patient details";
    var patient = Model.Patient;
}
<div class="page-heading"><div><div class="eyebrow">Patient record · <span class="code-pill">@patient.PatientCode</span></div><h1>@patient.FullName</h1><p>Registered @patient.RegistrationDateUtc.ToString("dd MMM yyyy") UTC</p></div><div class="action-row"><a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@patient.PatientId">Edit details</a><a class="btn btn-primary" asp-controller="Appointments" asp-action="Create">Book appointment</a></div></div>
<div class="row g-3">
    <div class="col-lg-7"><section class="panel h-100"><div class="panel-heading"><h2>Patient information</h2><span class="badge-status @(patient.IsActive ? "status-active" : "status-inactive")">@(patient.IsActive ? "Active" : "Inactive")</span></div><dl class="detail-grid"><div class="detail-item"><dt>Date of birth</dt><dd>@patient.DateOfBirth.ToString("dd MMM yyyy")</dd></div><div class="detail-item"><dt>Gender</dt><dd>@patient.Gender</dd></div><div class="detail-item"><dt>Phone</dt><dd>@patient.PhoneNumber</dd></div><div class="detail-item"><dt>Email</dt><dd>@(patient.Email ?? "Not provided")</dd></div><div class="detail-item"><dt>Address</dt><dd>@patient.Address</dd></div><div class="detail-item"><dt>Historical bills</dt><dd>@Model.BillCount</dd></div></dl>
    @if (patient.IsActive) { <form asp-action="Deactivate" asp-route-id="@patient.PatientId" method="post" class="mt-4" data-confirm="Deactivate this patient? Historical records will be kept."><button class="btn btn-sm btn-outline-danger" type="submit">Deactivate patient</button></form> }
    </section></div>
    <div class="col-lg-5"><section class="panel h-100"><div class="panel-heading"><h2>Recent appointments</h2><a class="text-muted-small" asp-controller="Appointments" asp-action="Index" asp-route-patientSearch="@patient.PatientCode">View all</a></div>
    @if (Model.RecentAppointments.Count == 0) { <div class="empty-state"><div class="empty-mark">◷</div><h3>No appointments yet</h3><p>Appointments will appear here after booking.</p></div> }
    else { <div class="d-grid gap-2">@foreach (var appointment in Model.RecentAppointments) { <a class="p-3 border rounded-3" asp-controller="Appointments" asp-action="Details" asp-route-id="@appointment.AppointmentId"><span class="record-primary">@appointment.AppointmentDateTimeLocal.ToString("dd MMM yyyy, h:mm tt")</span><span class="record-secondary">@appointment.DoctorName · @appointment.Status</span></a> }</div> }
    </section></div>
</div>
